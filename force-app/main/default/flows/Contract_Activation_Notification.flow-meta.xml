    <status>Active</status>
    <textTemplates>
        <name>EmailBodyTxt</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;Contract Details:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Contract for {!$Record.Account.Name} &lt;/p&gt;&lt;p&gt;Contract Owner {!$Record.OwnerId}&lt;/p&gt;&lt;p&gt;Contract Category {!$Record.Contract_Category__c}&lt;/p&gt;&lt;p&gt;Contract Sector - {!$Record.Sector__c}&lt;/p&gt;&lt;p&gt;Total Contract Value {!$Record.Total_Contract_Value__c}&lt;/p&gt;&lt;p&gt;Start Date - {!$Record.StartDate}&lt;/p&gt;&lt;p&gt;End Date - {!$Record.EndDate}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Contract Activated : {!$Record.Name} for {!$Record.Account.Name}</text>
    </textTemplates>
</Flow>
